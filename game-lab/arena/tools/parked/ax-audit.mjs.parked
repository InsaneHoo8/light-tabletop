/* Проверка доступности «Арены» в настоящем Chrome через DevTools Protocol.
   Смотрит дерево доступности, живую область, двухшаговый выбор, клавиши, контраст.
   Запуск: node game-lab/arena/tools/ax-audit.mjs */
import { spawn, execFileSync } from 'node:child_process';
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const here = path.dirname(fileURLToPath(import.meta.url));
const pageUrl = pathToFileURL(path.join(here, '..', 'index.html')).href;

const CHROME = [
  'C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe',
  'C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe',
  process.env.LOCALAPPDATA + '\\Google\\Chrome\\Application\\chrome.exe',
  'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe'
].find((p) => p && fs.existsSync(p));
if (!CHROME) {
  console.error('Не найден Chrome или Edge.');
  process.exit(2);
}

const port = 9800 + Math.floor(Math.random() * 400);
const userDir = path.join(os.tmpdir(), 'arena-audit-' + Date.now());
const child = spawn(
  CHROME,
  [
    '--headless=new',
    '--remote-debugging-port=' + port,
    '--user-data-dir=' + userDir,
    '--no-first-run',
    '--no-default-browser-check',
    '--disable-gpu',
    '--allow-file-access-from-files',
    '--window-size=1280,1100',
    pageUrl
  ],
  { stdio: 'ignore', windowsHide: true }
);

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
let ws = null;
let msgId = 0;
const pendingMap = new Map();
const consoleErrors = [];

function send(method, params = {}) {
  return new Promise((resolve, reject) => {
    const id = ++msgId;
    pendingMap.set(id, { resolve, reject });
    ws.send(JSON.stringify({ id, method, params }));
    setTimeout(() => {
      if (pendingMap.has(id)) {
        pendingMap.delete(id);
        reject(new Error('таймаут CDP: ' + method));
      }
    }, 15000);
  });
}

async function waitForTarget() {
  for (let i = 0; i < 60; i++) {
    try {
      const res = await fetch('http://127.0.0.1:' + port + '/json/list');
      const list = await res.json();
      const page = list.find((t) => t.type === 'page' && t.url.startsWith('file:'));
      if (page && page.webSocketDebuggerUrl) return page;
    } catch (e) {}
    await sleep(250);
  }
  throw new Error('Chrome не отдал страницу');
}

function cleanup() {
  try {
    if (ws) ws.close();
  } catch (e) {}
  try {
    execFileSync('taskkill', ['/PID', String(child.pid), '/T', '/F'], { stdio: 'ignore' });
  } catch (e) {}
  try {
    fs.rmSync(userDir, { recursive: true, force: true });
  } catch (e) {}
}

const results = [];
function check(name, cond, detail) {
  results.push(!!cond);
  console.log((cond ? 'OK   ' : 'FAIL ') + name + (!cond && detail !== undefined ? ' -> ' + detail : ''));
}

async function main() {
  const target = await waitForTarget();
  ws = new WebSocket(target.webSocketDebuggerUrl);
  await new Promise((res, rej) => {
    ws.addEventListener('open', res, { once: true });
    ws.addEventListener('error', rej, { once: true });
  });
  ws.addEventListener('message', (ev) => {
    const msg = JSON.parse(ev.data);
    if (msg.id && pendingMap.has(msg.id)) {
      const { resolve, reject } = pendingMap.get(msg.id);
      pendingMap.delete(msg.id);
      if (msg.error) reject(new Error(msg.error.message));
      else resolve(msg.result);
      return;
    }
    if (msg.method === 'Runtime.exceptionThrown') consoleErrors.push(msg.params.exceptionDetails.text);
    if (msg.method === 'Log.entryAdded' && msg.params.entry.level === 'error') consoleErrors.push(msg.params.entry.text);
  });

  await send('Runtime.enable');
  await send('Log.enable');
  await send('Accessibility.enable');

  for (let i = 0; i < 40; i++) {
    const r = await send('Runtime.evaluate', {
      expression: 'document.readyState + "|" + (window.__arena ? "app" : "noapp")',
      returnByValue: true
    });
    if (r.result.value === 'complete|app') break;
    await sleep(150);
  }
  await sleep(500);

  const evalJS = async (expression) => {
    const r = await send('Runtime.evaluate', { expression, returnByValue: true, awaitPromise: true });
    if (r.exceptionDetails) throw new Error(r.exceptionDetails.text);
    return r.result.value;
  };

  const press = async (key, code, wvkc) => {
    await send('Input.dispatchKeyEvent', {
      type: 'keyDown',
      key,
      code,
      windowsVirtualKeyCode: wvkc,
      nativeVirtualKeyCode: wvkc,
      text: key.length === 1 ? key : undefined
    });
    await send('Input.dispatchKeyEvent', { type: 'keyUp', key, code, windowsVirtualKeyCode: wvkc, nativeVirtualKeyCode: wvkc });
    await sleep(180);
  };

  check('язык страницы ru', (await evalJS('document.documentElement.lang')) === 'ru');

  const { nodes } = await send('Accessibility.getFullAXTree');
  const roleOf = (n) => (n.role && n.role.value) || '';
  const nameOf = (n) => (n.name && n.name.value) || '';
  const propOf = (n, p) => {
    const f = (n.properties || []).find((x) => x.name === p);
    return f ? f.value.value : undefined;
  };

  const live = nodes.filter((n) => roleOf(n) === 'status');
  check('одна живая область', live.length === 1, live.length);
  if (live.length) {
    check('живая область вежливая', propOf(live[0], 'live') === 'polite', String(propOf(live[0], 'live')));
    check('живая область атомарна', propOf(live[0], 'atomic') === true || propOf(live[0], 'atomic') === 'true');
  }

  const buttons = nodes.filter((n) => roleOf(n) === 'button');
  check('шесть кнопок действий', buttons.length >= 6, buttons.length);
  check('у всех кнопок есть имя', buttons.every((n) => nameOf(n).trim().length > 0));
  check('у кнопок объявлены горячие клавиши', nodes.filter((n) => propOf(n, 'keyshortcuts')).length >= 6);

  check('счёт стола оформлен таблицей', nodes.filter((n) => roleOf(n) === 'table').length === 1);
  check('в таблице четыре бойца', (await evalJS('document.querySelectorAll("#table-body tr").length')) === 4);
  check('автодобор выключен', (await evalJS('window.__arena.state().opts.autoDraw')) !== true);
  check('раздача ступенчатая', (await evalJS('window.__arena.state().opts.startMode')) === 'position');
  check(
    'руки на старте: 0, 1, 1, 2',
    JSON.stringify(await evalJS('window.__arena.state().players.map(function(p){return p.hand.length;})')) === '[0,1,1,2]',
    JSON.stringify(await evalJS('window.__arena.state().players.map(function(p){return p.hand.length;})'))
  );

  /* По умолчанию способности личные: раздела драфта нет. */
  check('раздел выбора руки виден', (await evalJS('document.getElementById("draft-section").hidden')) === false);
  const personal = await evalJS('JSON.stringify(window.__arena.state().players.map(function(p){return p.pool.length;}))');
  check('у каждого свой пул способностей', personal !== '[0,0,0,0]', personal);

  /* Драфт включается отдельно. */
  await evalJS('window.__arena.setDraft(true)');
  await sleep(250);
  check('раздел драфта виден', (await evalJS('!document.getElementById("draft-section").hidden')) === true);
  const poolCount = await evalJS('document.querySelectorAll("#draft-list button").length');
  check('в драфте весь пул', poolCount === 52, String(poolCount));
  const firstDraft = await evalJS('document.activeElement && document.activeElement.getAttribute("data-id")');
  check('фокус на первой карте драфта', !!firstDraft && firstDraft !== 'attack', String(firstDraft));

  await evalJS('document.activeElement && document.activeElement.click()');
  await sleep(200);
  const hands = await evalJS('JSON.stringify(window.__arena.state().players.map(function(p){return p.abilities.length;}))');
  check('после первого круга у вас одна карта, у ботов по две', hands === '[1,2,2,2]', hands);

  await evalJS('window.__arena.autoDraft()');
  await sleep(250);
  check('после драфта партия началась', (await evalJS('window.__arena.state().phase')) === 'main');

  await evalJS('window.__arena.setDraft(false)');
  await sleep(200);

  const activeId = await evalJS('document.activeElement && document.activeElement.getAttribute("data-id")');
  check('фокус на первом действии', activeId === 'attack', String(activeId));

  /* Двухшаговый выбор: способность, затем цель. Бойцы заданы, иначе проверка
     зависит от случайного персонажа и «не хватает маны» ломает сценарий. */
  await evalJS("window.__arena.newGame({chars:['hrom','vor','mag','lyusya']}); window.__arena.autoPick();");
  await sleep(200);
  await press('3', 'Digit3', 51);
  const q1 = await evalJS('window.__arena.announceText()');
  const optCount = await evalJS('document.querySelectorAll("#options button").length');
  check('способность просит выбор', optCount > 0, 'вариантов ' + optCount);
  check('вопрос произнесён словами', /Какую способность/.test(q1), q1.slice(0, 90));
  const optNames = await evalJS('Array.from(document.querySelectorAll("#options button")).map(b => b.textContent).join(" | ")');
  check('варианты пронумерованы', /^1 — /.test(optNames), optNames.slice(0, 90));

  await press('1', 'Digit1', 49);
  const q2 = await evalJS('window.__arena.announceText()');
  const stillOptions = await evalJS('document.querySelectorAll("#options button").length');
  check('второй шаг либо цель, либо результат', stillOptions > 0 || /./.test(q2), q2.slice(0, 80));

  if (stillOptions > 0) {
    await press('1', 'Digit1', 49);
    const q3 = await evalJS('window.__arena.announceText()');
    check('выбор цели завершает действие', q3.length > 20, q3.slice(0, 80));
  }

  check('после действия ход ушёл боту', (await evalJS('window.__arena.state().turn !== 0')) === true);

  /* Пробел двигает ботов. */
  const turnBefore = await evalJS('window.__arena.state().turn');
  await press(' ', 'Space', 32);
  const turnAfter = await evalJS('window.__arena.state().turn');
  check('Пробел делает ход бота', turnAfter !== turnBefore || (await evalJS('window.__arena.state().phase')) === 'over', turnBefore + '->' + turnAfter);

  /* Отмена выбора по Escape. */
  await evalJS('window.__arena.newGame(); window.__arena.autoPick();');
  await press('2', 'Digit2', 50);
  const afterTake = await evalJS('window.__arena.announceText()');
  check('взятие артефакта произносится', /артефакт/i.test(afterTake), afterTake.slice(0, 80));

  await evalJS('window.__arena.newGame(); window.__arena.autoPick();');
  await press('3', 'Digit3', 51);
  await press('Escape', 'Escape', 27);
  const afterEsc = await evalJS('document.querySelectorAll("#options button").length');
  check('Escape убирает выбор', afterEsc === 0, 'осталось ' + afterEsc);

  /* Статус по требованию. */
  await press('s', 'KeyS', 83);
  const st = await evalJS('window.__arena.announceText()');
  check('S проговаривает стол', /Здоровье/.test(st) && /Менталка/.test(st), st.slice(0, 90));

  /* Повтор. */
  await evalJS(
    'window.__muts = 0; window.__obs = new MutationObserver(function(){ window.__muts++; });' +
      'window.__obs.observe(document.getElementById("announce"), {childList:true, characterData:true, subtree:true});'
  );
  await press('r', 'KeyR', 82);
  await sleep(280);
  check('R заставляет диктора повторить', (await evalJS('window.__muts')) > 0);

  /* Отмена хода: сначала делаем ход, потом отменяем. */
  await evalJS('window.__arena.newGame(); window.__arena.autoPick();');
  await press('1', 'Digit1', 49);
  await press('1', 'Digit1', 49);
  const afterAttack = await evalJS('window.__arena.state().turn');
  await press('u', 'KeyU', 85);
  const undoTxt = await evalJS('window.__arena.announceText()');
  const turnAfterUndo = await evalJS('window.__arena.state().turn');
  check(
    'U возвращает и ход, и состояние',
    /отменён/.test(undoTxt) && turnAfterUndo === 0 && afterAttack !== 0,
    undoTxt.slice(0, 60) + ' | turn ' + afterAttack + '->' + turnAfterUndo
  );

  const metrics = await evalJS(`
    (function () {
      function lum(c) {
        var m = c.match(/\\d+(\\.\\d+)?/g).map(Number).slice(0, 3).map(function (v) {
          v = v / 255;
          return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
        });
        return 0.2126 * m[0] + 0.7152 * m[1] + 0.0722 * m[2];
      }
      function ratio(a, b) {
        var l1 = lum(a), l2 = lum(b);
        return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);
      }
      var cs = getComputedStyle(document.body);
      var ann = getComputedStyle(document.getElementById('announce'));
      var btn = getComputedStyle(document.querySelector('#actions button'));
      return {
        body: ratio(cs.color, cs.backgroundColor),
        announce: ratio(ann.color, getComputedStyle(document.querySelector('.now')).backgroundColor),
        button: ratio(btn.color, btn.backgroundColor),
        fontPx: parseFloat(getComputedStyle(document.documentElement).fontSize)
      };
    })()
  `);
  check('контраст текста не ниже 7:1', metrics.body >= 7, metrics.body.toFixed(2));
  check('контраст сообщения не ниже 4.5:1', metrics.announce >= 4.5, metrics.announce.toFixed(2));
  check('контраст кнопок не ниже 4.5:1', metrics.button >= 4.5, metrics.button.toFixed(2));
  check('размер текста не меньше 18px', metrics.fontPx >= 18, metrics.fontPx);
  check('в консоли нет ошибок', consoleErrors.length === 0, consoleErrors.join(' | ').slice(0, 200));

  const bad = await evalJS(`
    (function () {
      var bad = [];
      document.querySelectorAll('button, input, a[href]').forEach(function (el) {
        if (el.getAttribute('aria-hidden') === 'true') bad.push('aria-hidden');
        if (el.tabIndex < 0 && !el.hasAttribute('tabindex')) bad.push(el.textContent.trim().slice(0, 20));
      });
      return bad;
    })()
  `);
  check('все элементы управления достижимы', bad.length === 0, bad.join(', '));

  const failed = results.filter((r) => !r).length;
  console.log('');
  console.log(failed === 0 ? 'Доступность: все ' + results.length + ' проверок пройдены.' : 'Провалено: ' + failed + ' из ' + results.length);
  return failed;
}

main()
  .then((f) => {
    cleanup();
    process.exit(f === 0 ? 0 : 1);
  })
  .catch((e) => {
    console.error('Ошибка проверки:', e.message);
    cleanup();
    process.exit(2);
  });
